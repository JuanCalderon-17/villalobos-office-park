---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// itens: [rótulo em negrito, resto do texto]
const espacos = [
  {
    numero: "1.",
    nome: "AUDITÓRIO DR. PAULO SARTI",
    descricao:
      "Nosso maior espaço, ideal para eventos de grande porte como palestras, simpósios e grandes apresentações corporativas. Possui um palco elevado, púlpito e estrutura completa de sonorização e projeção. O layout em formato “auditório” maximiza a capacidade e garante excelente visibilidade do palco de qualquer ponto da sala.",
    itens: [
      ["Ideal para:", "Conferências, Seminários e Apresentações Magnas."],
      ["Capacidade:", "200 pessoas"],
    ],
    textoNaDireita: true,
    galeria: "auditorio",
  },
  {
    numero: "2.",
    nome: "SALA TOWERS",
    descricao:
      "Um auditório versátil e confortável, perfeito para apresentações, seminários e workshops de médio porte. Assim como o auditório principal, é configurado com cadeiras voltadas para a frente, otimizando o foco no apresentador e no conteúdo. A sala conta com mesa de apoio frontal, projetor e tela de alta definição.",
    itens: [
      ["Ideal para:", "Workshops, Lançamentos de Produto e Palestras de médio porte."],
      ["Capacidade:", "50 pessoas"],
      ["Modular:", "Mesas Opcionais"],
    ],
    textoNaDireita: false,
    galeria: "towers",
  },
  {
    numero: "3.",
    nome: "SALA VILLAGE",
    descricao:
      "Esta sala foi projetada para a colaboração e o aprendizado. Montada no “formato escola”, com mesas longas e cadeiras, é o ambiente perfeito para cursos, treinamentos práticos e reuniões de planejamento onde os participantes precisam de espaço para anotações ou uso de notebooks. É um espaço mais reservado que incentiva a interação e a produtividade.",
    itens: [
      ["Ideal para:", "Treinamentos, Workshops Interativos e Reuniões Estratégicas."],
      ["Capacidade:", "50 pessoas"],
    ],
    textoNaDireita: true,
    galeria: "village",
  },
];

const salas = ["Auditório", "Sala Towers", "Sala Village"];
---

<Base
  title="Salas e Auditórios | Villa Lobos Office Park"
  description="Auditórios e salas para eventos no Villa Lobos Office Park: Auditório Dr. Paulo Sarti (200 pessoas), Sala Towers e Sala Village (50 pessoas). Disponíveis para locação."
>
  <Header active="eventos" />

  <main>
    <section class="pt-[169px]">
      <img
        src="/img/salas/hero.webp"
        alt="Auditório do Villa Lobos Office Park"
        width="1920"
        height="1000"
        data-reveal="slideInDown"
        data-reveal-delay="700"
        class="h-[420px] w-full object-cover lg:h-[792px]"
      />
    </section>

    <section class="bg-fog px-6 py-16 lg:px-[61px]">
      <div class="mx-auto flex max-w-[1400px] flex-col gap-5">
        <span class="font-sans text-2xl leading-6 font-semibold text-sand">
          CONHEÇA AS OPÇÕES DE
        </span>
        <h1 class="mb-6 font-sans text-[32px] leading-[38px] font-semibold text-ink lg:text-[50px] lg:leading-[50px]">
          AUDITÓRIOS E ESPAÇOS PARA EVENTOS
        </h1>
        <p class="font-sans text-[18px] leading-6 text-graytext">
          O Villa Lobos Office Park oferece uma infraestrutura de eventos completa,
          projetada para impressionar e garantir o sucesso de suas reuniões, conferências e
          treinamentos.
        </p>
        <p class="font-sans text-[18px] leading-6 text-graytext">
          Nossos espaços são modernos, climatizados, e equipados com tecnologia audiovisual
          de ponta. A flexibilidade é a nossa prioridade: todos os auditórios e salas estão
          disponíveis para locação tanto para as empresas residentes em nosso condomínio
          quanto para o público externo.
        </p>
        <p class="font-sans text-[18px] leading-6 text-graytext">
          Contamos com um foyer dedicado para o credenciamento e coffee breaks, além de um
          acesso imponente que recebe seus convidados com elegância.
        </p>
      </div>
    </section>

    {
      espacos.map((espaco) => (
        <section class="px-6 py-16 lg:px-[61px]">
          <div class="mx-auto grid max-w-[1400px] items-center gap-12 lg:grid-cols-2">
            <div class:list={["flex flex-col gap-6", espaco.textoNaDireita && "lg:order-2"]}>
              <span
                class="font-sans text-[70px] leading-[70px] font-black text-[#d5ce9c]"
                aria-hidden="true"
              >
                {espaco.numero}
              </span>
              <h2 class="font-sans text-[35px] leading-[35px] font-semibold text-graytext">
                {espaco.nome}
              </h2>
              <p class="font-sans text-xl leading-8 text-graytext">{espaco.descricao}</p>
              <ul class="flex flex-col gap-3">
                {espaco.itens.map(([rotulo, texto]) => (
                  <li class="flex items-center gap-3 font-sans text-2xl leading-[38px] text-ink">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 512 512"
                      fill="#bacfc6"
                      aria-hidden="true"
                      class="shrink-0"
                    >
                      <path d="M256 8C119 8 8 119 8 256s111 248 248 248 248-111 248-248S393 8 256 8z" />
                    </svg>
                    <span>
                      <strong class="font-bold">{rotulo}</strong> {texto}
                    </span>
                  </li>
                ))}
              </ul>
              <a
                href="#reservar"
                data-reveal="fadeInUp"
                data-reveal-delay="600"
                class="w-fit rounded-lg bg-mint px-6 py-3 font-sans text-xl leading-5 text-white"
              >
                RESERVAR SALA
              </a>
            </div>

            <div class:list={["grid gap-5", espaco.textoNaDireita && "lg:order-1"]}>
              {espaco.galeria === "auditorio" && (
                <>
                  <img
                    src="/img/salas/auditorio-1.webp"
                    alt="Auditório Dr. Paulo Sarti"
                    width="700"
                    height="364"
                    loading="lazy"
                    class="h-[240px] w-full object-cover lg:h-[364px]"
                  />
                  <div class="grid grid-cols-2 gap-5">
                    <div class="flex flex-col gap-5">
                      <img
                        src="/img/salas/auditorio-2.webp"
                        alt=""
                        width="308"
                        height="364"
                        loading="lazy"
                        class="h-[240px] w-full object-cover lg:h-[364px]"
                      />
                      <img
                        src="/img/salas/auditorio-3.webp"
                        alt=""
                        width="308"
                        height="175"
                        loading="lazy"
                        class="h-[130px] w-full object-cover lg:h-[175px]"
                      />
                    </div>
                    <div class="flex flex-col gap-5">
                      <img
                        src="/img/salas/auditorio-4.webp"
                        alt=""
                        width="364"
                        height="242"
                        loading="lazy"
                        class="h-[170px] w-full object-cover lg:h-[242px]"
                      />
                      <img
                        src="/img/salas/auditorio-5.webp"
                        alt=""
                        width="364"
                        height="280"
                        loading="lazy"
                        class="h-[200px] w-full object-cover lg:h-[280px]"
                      />
                    </div>
                  </div>
                </>
              )}

              {espaco.galeria === "towers" && (
                <>
                  <img
                    src="/img/salas/towers-1.webp"
                    alt="Sala Towers"
                    width="770"
                    height="401"
                    loading="lazy"
                    class="h-[260px] w-full object-cover lg:h-[401px]"
                  />
                  <img
                    src="/img/salas/towers-2.webp"
                    alt=""
                    width="431"
                    height="359"
                    loading="lazy"
                    class="h-[240px] w-full object-cover lg:h-[359px] lg:w-[431px]"
                  />
                </>
              )}

              {espaco.galeria === "village" && (
                <>
                  <img
                    src="/img/salas/village-1.webp"
                    alt="Sala Village"
                    width="700"
                    height="529"
                    loading="lazy"
                    class="h-[300px] w-full object-cover lg:h-[529px]"
                  />
                  <img
                    src="/img/salas/village-2.webp"
                    alt=""
                    width="336"
                    height="453"
                    loading="lazy"
                    class="h-[300px] w-full object-cover lg:ml-auto lg:h-[453px] lg:w-[336px]"
                  />
                </>
              )}
            </div>
          </div>
        </section>
      ))
    }

    <section id="reservar" class="scroll-mt-[169px] bg-mist px-6 py-16 lg:px-[61px]">
      <div class="mx-auto max-w-[1100px]">
        <h2 class="font-sans text-[28px] leading-[34px] font-semibold text-steel">
          Para reservar uma sala, preencha o formulário abaixo:
        </h2>

        <form id="form-reserva" class="mt-10 grid gap-5 sm:grid-cols-2">
          <div class="flex flex-col gap-2">
            <label for="nome" class="font-sans text-sm text-graytext">Nome *</label>
            <input
              id="nome"
              name="nome"
              type="text"
              required
              class="rounded-lg border border-haze bg-white px-4 py-3 font-sans text-base text-ink"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label for="sobrenome" class="font-sans text-sm text-graytext">Sobrenome *</label>
            <input
              id="sobrenome"
              name="sobrenome"
              type="text"
              required
              class="rounded-lg border border-haze bg-white px-4 py-3 font-sans text-base text-ink"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label for="telefone" class="font-sans text-sm text-graytext">Telefone *</label>
            <input
              id="telefone"
              name="telefone"
              type="tel"
              required
              class="rounded-lg border border-haze bg-white px-4 py-3 font-sans text-base text-ink"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label for="email" class="font-sans text-sm text-graytext">E-mail *</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="rounded-lg border border-haze bg-white px-4 py-3 font-sans text-base text-ink"
            />
          </div>

          <div class="flex flex-col gap-2 sm:col-span-2">
            <label for="empresa" class="font-sans text-sm text-graytext">Empresa</label>
            <input
              id="empresa"
              name="empresa"
              type="text"
              class="rounded-lg border border-haze bg-white px-4 py-3 font-sans text-base text-ink"
            />
          </div>

          <fieldset class="flex flex-col gap-3 sm:col-span-2">
            <legend class="mb-1 font-sans text-base font-bold text-ink">
              Selecione a sala que gostaria de reservar: *
            </legend>
            {
              salas.map((sala, i) => (
                <label class="flex items-center gap-3 font-sans text-base text-ink">
                  <input
                    type="radio"
                    name="sala"
                    value={sala}
                    required={i === 0}
                    class="h-4 w-4 accent-mint"
                  />
                  {sala}
                </label>
              ))
            }
          </fieldset>

          <div class="flex flex-col gap-2 sm:col-span-2">
            <label for="solicitacao" class="font-sans text-sm text-graytext">Solicitação *</label>
            <textarea
              id="solicitacao"
              name="solicitacao"
              rows="5"
              required
              class="rounded-lg border border-haze bg-white px-4 py-3 font-sans text-base text-ink"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-fit rounded-lg bg-mint px-8 py-4 font-sans text-[17px] leading-[17px] font-medium text-fog sm:col-span-2"
          >
            SOLICITAR AGENDAMENTO
          </button>
        </form>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<script>
  const form = document.getElementById("form-reserva") as HTMLFormElement | null;

  form?.addEventListener("submit", (evento) => {
    evento.preventDefault();
    const dados = new FormData(form);
    const valor = (chave: string) => String(dados.get(chave) || "").trim();

    const corpo = [
      `Nome: ${valor("nome")} ${valor("sobrenome")}`,
      `Telefone: ${valor("telefone")}`,
      `E-mail: ${valor("email")}`,
      `Empresa: ${valor("empresa") || "-"}`,
      `Sala desejada: ${valor("sala") || "-"}`,
      "",
      valor("solicitacao") || "-",
    ].join("\n");

    const assunto = `Reserva de sala — ${valor("sala")} — ${valor("nome")} ${valor("sobrenome")}`;
    window.location.href =
      `mailto:assistente.administrativo@cvlop.com.br` +
      `?subject=${encodeURIComponent(assunto)}&body=${encodeURIComponent(corpo)}`;
  });
</script>
