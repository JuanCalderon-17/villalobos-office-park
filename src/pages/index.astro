---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import BarraCategorias from "../components/BarraCategorias.astro";
import Categorias from "../components/Categorias.astro";
import Stats from "../components/Stats.astro";
import PoloInovacao from "../components/PoloInovacao.astro";
import Infraestrutura from "../components/Infraestrutura.astro";
import Programacao from "../components/Programacao.astro";
import CtaContato from "../components/CtaContato.astro";
import Footer from "../components/Footer.astro";
---

<Base>
  <Header active="home" />
  <main>
    <Hero />
    <BarraCategorias />
    <Categorias />
    <Stats />
    <PoloInovacao />
    <Infraestrutura />
    <Programacao />
    <CtaContato />
  </main>
  <Footer />
</Base>
