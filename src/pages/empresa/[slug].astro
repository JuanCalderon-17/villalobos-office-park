---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import data from "../../data/empresas.json";

export function getStaticPaths() {
  return data.empresas.map((empresa) => ({
    params: { slug: empresa.slug },
    props: { empresa },
  }));
}

const { empresa } = Astro.props;

const siteLabel = empresa.site.replace(/^https?:\/\//, "").replace(/\/$/, "");

const contatos = [
  empresa.site && { rotulo: "Site", valor: siteLabel, href: empresa.site, externo: true },
  empresa.telefone && { rotulo: "Telefone", valor: empresa.telefone, href: empresa.telefoneHref },
  empresa.email && { rotulo: "Email", valor: empresa.email, href: `mailto:${empresa.email}` },
].filter(Boolean) as { rotulo: string; valor: string; href: string; externo?: boolean }[];

const localizacao = [
  empresa.sala && { rotulo: "Número da Sala", valor: empresa.sala },
  empresa.predio && { rotulo: "Prédio", valor: empresa.predio },
].filter(Boolean) as { rotulo: string; valor: string }[];
---

<Base
  title={`${empresa.nome} | Villa Lobos Office Park`}
  description={empresa.descricao.slice(0, 160) ||
    `${empresa.nome} no Villa Lobos Office Park. ${empresa.localizacao}`}
>
  <Header active="empresas" />

  <main class="pt-[169px] pb-16">
    <div class="mx-auto max-w-[1522px] px-6 lg:px-[200px]">
      <nav class="py-6 text-[14px] text-graytext">
        <a href="/empresas" class="hover:text-mint">empresas</a>
        <span class="mx-2">/</span>
        <span>{empresa.nome}</span>
      </nav>

      <div class="grid gap-8 lg:grid-cols-[1fr_380px]">
        <div>
          <div class="overflow-hidden rounded-[12px] bg-white">
            {
              empresa.logo && (
                <img
                  src={empresa.logo}
                  alt={empresa.nome}
                  width="600"
                  height="400"
                  class="h-[360px] w-full object-cover"
                />
              )
            }
            <div class="px-8 py-8">
              <h1 class="text-[28px] leading-[34px] font-medium text-slate">{empresa.nome}</h1>
              <p class="mt-3 text-[14px] leading-[22px] text-carbon">
                {empresa.categorias.join(" · ")}
                {empresa.localizacao && <span> · {empresa.localizacao}</span>}
              </p>
            </div>
          </div>

          {
            empresa.descricao && (
              <section class="mt-8 rounded-[12px] bg-white px-8 py-8">
                <h2 class="text-[20px] leading-[26px] font-semibold text-steel">Descrição</h2>
                <p class="mt-4 text-[16px] leading-[26px] text-graytext">{empresa.descricao}</p>
              </section>
            )
          }
        </div>

        <aside class="flex flex-col gap-8">
          {
            contatos.length > 0 && (
              <section class="rounded-[12px] bg-white px-8 py-8">
                <h2 class="text-[20px] leading-[26px] font-semibold text-steel">Informações</h2>
                <dl class="mt-4 flex flex-col gap-4">
                  {contatos.map((c) => (
                    <div>
                      <dt class="text-[13px] text-graytext">{c.rotulo}</dt>
                      <dd class="mt-1 text-[15px] break-words text-carbon">
                        <a
                          href={c.href}
                          target={c.externo ? "_blank" : undefined}
                          rel={c.externo ? "noopener" : undefined}
                          class="hover:text-mint"
                        >
                          {c.valor}
                        </a>
                      </dd>
                    </div>
                  ))}
                </dl>
              </section>
            )
          }

          {
            (localizacao.length > 0 || empresa.horario) && (
              <section class="rounded-[12px] bg-white px-8 py-8">
                <h2 class="text-[20px] leading-[26px] font-semibold text-steel">Localização</h2>
                <dl class="mt-4 flex flex-col gap-4">
                  {localizacao.map((l) => (
                    <div>
                      <dt class="text-[13px] text-graytext">{l.rotulo}</dt>
                      <dd class="mt-1 text-[15px] text-carbon">{l.valor}</dd>
                    </div>
                  ))}
                  {empresa.horario && (
                    <div>
                      <dt class="text-[13px] text-graytext">Horário</dt>
                      <dd class="mt-1 text-[15px] text-carbon">
                        {empresa.horario.abre} às {empresa.horario.fecha}
                      </dd>
                    </div>
                  )}
                </dl>
              </section>
            )
          }

          <a
            href="/empresas"
            class="rounded-[8px] bg-mint px-6 py-3 text-center text-[16px] text-white"
          >
            Ver todas as empresas
          </a>
        </aside>
      </div>
    </div>
  </main>

  <Footer />
</Base>
