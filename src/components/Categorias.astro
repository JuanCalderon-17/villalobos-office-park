---
const icones: Record<string, string> = {
  regua:
    '<path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25ZM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83Z" fill="currentColor"/>',
  carro:
    '<path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-1h12v1a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-8l-2.08-5.99ZM6.5 16a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Zm11 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3ZM5 11l1.5-4.5h11L19 11H5Z" fill="currentColor"/>',
  livro:
    '<path d="M6 2h12a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm2 4v2h8V6H8Zm0 4v2h8v-2H8Z" fill="currentColor"/>',
  casa: '<path d="M12 3 2 12h3v8h6v-5h2v5h6v-8h3L12 3Zm0 6.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4Z" fill="currentColor"/>',
  saude:
    '<path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm5 11h-4v4h-2v-4H7v-2h4V7h2v4h4v2Z" fill="currentColor"/>',
};

// cardAnim/cardDelay animam a foto inteira; barAnim/barDelay animam só a barra
// branca do ícone. No original as duas são independentes (a barra "chega" um
// pouco depois da foto) — valores extraídos do data-settings do Elementor.
const categorias = [
  {
    titulo: "ARQUITETURA E DESIGN",
    subtitulo: "Estúdios e agências",
    icone: "regua",
    img: "/img/categorias/arquitetura.jpg",
    filtro: "Arquitetura e Design",
    cardAnim: "fadeInUp",
    cardDelay: 500,
    barAnim: "fadeInUp",
    barDelay: 600,
  },
  {
    titulo: "AUTOMOTIVO",
    subtitulo: "Concessionárias",
    icone: "carro",
    img: "/img/categorias/automotivo.jpg",
    filtro: "Automotivo",
    cardAnim: "fadeInUp",
    cardDelay: 1000,
    barAnim: "fadeInRight",
    barDelay: 600,
  },
];

const categoriasSecundarias = [
  {
    titulo: "ADVOCACIA",
    subtitulo: "Escritórios",
    icone: "livro",
    img: "/img/categorias/advocacia.jpg",
    filtro: "Advocacia",
    cardAnim: "fadeInLeft",
    cardDelay: 500,
    barAnim: "fadeInUp",
    barDelay: 600,
  },
  {
    titulo: "IMOBILIÁRIA",
    subtitulo: "Venda e Aluguel",
    icone: "casa",
    img: "/img/categorias/imobiliaria.jpg",
    filtro: "Imobilário",
    cardAnim: "fadeIn",
    cardDelay: 700,
    barAnim: "fadeInLeft",
    barDelay: 800,
  },
  {
    titulo: "SAÚDE",
    subtitulo: "Clínicas e consultórios",
    icone: "saude",
    img: "/img/categorias/saude.jpg",
    filtro: "Saúde",
    cardAnim: "fadeInRight",
    cardDelay: 500,
    barAnim: "fadeInUp",
    barDelay: 600,
  },
];
---

<section class="bg-[linear-gradient(to_bottom,#ffffff_0%,#f5f5f5_100%)] px-6 py-16 lg:px-[61px]">
  <div class="mx-auto max-w-[1400px]">
    <div class="grid gap-8 lg:grid-cols-2">
      <div class="flex flex-col gap-6">
        <span class="font-sans text-xl leading-5 font-semibold tracking-[2px] text-sand">
          CATEGORIAS
        </span>
        <h2 class="max-w-[548px] font-sans text-[35px] leading-[56px] font-medium text-steel">
          CONHEÇA AS EMPRESAS QUE ESTÃO NO VILLA LOBOS OFFICE PARK
        </h2>
        <a
          href="/empresas"
          class="flex w-fit items-center gap-3 rounded-[8px] border border-haze bg-white px-6 py-3 font-sans text-[18px] leading-[18px] text-steel"
        >
          Ver todas
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M5 12h14m-6-6 6 6-6 6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <p class="font-sans text-xl leading-8 tracking-[-0.3px] text-graytext lg:pt-3">
        O Villa Lobos Office Park reúne uma comunidade diversificada de empresas, dos mais
        variados setores. Navegue pelas categorias ou explore nosso diretório completo para
        encontrar o serviço ou parceiro que você precisa.
      </p>
    </div>

    <div class="mt-12 grid gap-10 md:grid-cols-2">
      {
        categorias.map((c) => (
          <a
            href={`/empresas?categoria=${encodeURIComponent(c.filtro)}`}
            class="group relative block h-[440px] rounded-tl-[10px] bg-cover bg-center"
            style={`background-image: url('${c.img}')`}
            data-reveal={c.cardAnim}
            data-reveal-delay={c.cardDelay}
          >
            <div
              class="flex w-fit items-center gap-5 rounded-tl-[10px] bg-white pr-8"
              data-reveal={c.barAnim}
              data-reveal-delay={c.barDelay}
            >
              <span class="flex h-[59px] w-[59px] shrink-0 items-center justify-center rounded-tl-[10px] bg-mint text-white">
                <svg width="29" height="29" viewBox="0 0 24 24" set:html={icones[c.icone]} />
              </span>
              <span class="py-2">
                <span class="block font-sans text-[19px] leading-[26px] font-semibold text-slate">
                  {c.titulo}
                </span>
                <span class="block font-sans text-[18px] leading-[22px] text-mint">
                  {c.subtitulo}
                </span>
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-10 grid gap-10 md:grid-cols-2 lg:grid-cols-3">
      {
        categoriasSecundarias.map((c) => (
          <a
            href={`/empresas?categoria=${encodeURIComponent(c.filtro)}`}
            class="group relative block h-[480px] rounded-tl-[10px] bg-cover bg-center"
            style={`background-image: url('${c.img}')`}
            data-reveal={c.cardAnim}
            data-reveal-delay={c.cardDelay}
          >
            <div
              class="flex w-fit items-center gap-5 rounded-tl-[10px] bg-white pr-8"
              data-reveal={c.barAnim}
              data-reveal-delay={c.barDelay}
            >
              <span class="flex h-[59px] w-[59px] shrink-0 items-center justify-center rounded-tl-[10px] bg-mint text-white">
                <svg width="29" height="29" viewBox="0 0 24 24" set:html={icones[c.icone]} />
              </span>
              <span class="py-2">
                <span class="block font-sans text-[19px] leading-[26px] font-semibold text-slate">
                  {c.titulo}
                </span>
                <span class="block font-sans text-[18px] leading-[22px] text-mint">
                  {c.subtitulo}
                </span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
