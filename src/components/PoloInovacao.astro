      >
        SAIBA MAIS
      </a>
    </div>

    <div class="hidden pt-20 lg:block">
      <div class="grid grid-cols-2 gap-0">
        <div
          class="h-[258px] bg-cover bg-center"
          style="background-image: url('/img/Foto-VillaBobosOfficePark3.jpg');"
        >
        </div>
        <img
          src="/img/Foto-VillaBobosOfficePark.jpg"
          alt=""
          width="310"
          height="258"
          class="h-[258px] w-full object-cover"
        />
      </div>
    </div>
