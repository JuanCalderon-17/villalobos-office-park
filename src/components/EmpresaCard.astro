---
interface Empresa {
  slug: string;
  nome: string;
  categorias: string[];
  logo: string | null;
  localizacao: string;
  telefone: string;
  telefoneHref: string;
  email: string;
  site: string;
  horario: { abre: string; fecha: string } | null;
}

const { empresa } = Astro.props as { empresa: Empresa };

const icons = {
  pin: '<path d="M12 21s7-6.5 7-11.5A7 7 0 0 0 5 9.5C5 14.5 12 21 12 21Z" stroke="currentColor" stroke-width="1.6" fill="none"/><circle cx="12" cy="9.5" r="2.4" stroke="currentColor" stroke-width="1.6" fill="none"/>',
  clock: '<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="m3 7 9 6 9-6" stroke="currentColor" stroke-width="1.6" fill="none"/>',
  phone: '<path d="M6 3h3l2 5-2.5 1.5a12 12 0 0 0 6 6L16 13l5 2v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4 5.2 2 2 0 0 1 6 3Z" stroke="currentColor" stroke-width="1.6" fill="none"/>',
  globe: '<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18Z" stroke="currentColor" stroke-width="1.6" fill="none"/>',
};

const siteLabel = empresa.site.replace(/^https?:\/\//, "").replace(/\/$/, "");
---

<article
  class="flex h-full flex-col overflow-hidden rounded-[12px] bg-white"
  data-categorias={empresa.categorias.join("|")}
  data-nome={empresa.nome.toLowerCase()}
>
  <a href={`/empresa/${empresa.slug}`} class="block">
    {
      empresa.logo ? (
        <img
          src={empresa.logo}
          alt={empresa.nome}
          width="344"
          height="260"
          loading="lazy"
          class="h-[260px] w-full object-cover"
        />
      ) : (
        <div class="flex h-[260px] w-full items-center justify-center bg-mist text-sm text-graytext">
          {empresa.nome}
        </div>
      )
    }
  </a>

  <div class="flex flex-1 flex-col px-[20px] pt-[33px] pb-[24px]">
    <h2 class="text-[18px] leading-[20px] font-medium text-slate">
      <a href={`/empresa/${empresa.slug}`}>{empresa.nome}</a>
    </h2>

    <ul class="mt-[18px] flex flex-col gap-[10px] text-[14px] leading-[18px] text-carbon">
      {
        empresa.localizacao && (
          <li class="flex items-center gap-[10px]">
            <svg width="16" height="16" viewBox="0 0 24 24" class="shrink-0" aria-hidden="true" set:html={icons.pin} />
            <span class="truncate">{empresa.localizacao}</span>
          </li>
        )
      }
      {
        empresa.horario && (
          <li class="flex items-center gap-[10px]">
            <svg width="16" height="16" viewBox="0 0 24 24" class="shrink-0" aria-hidden="true" set:html={icons.clock} />
            <span>
              {empresa.horario.abre} – {empresa.horario.fecha}
            </span>
          </li>
        )
      }
      {
        empresa.email && (
          <li class="flex items-center gap-[10px]">
            <svg width="16" height="16" viewBox="0 0 24 24" class="shrink-0" aria-hidden="true" set:html={icons.mail} />
            <a href={`mailto:${empresa.email}`} class="truncate hover:text-mint">
              {empresa.email}
            </a>
          </li>
        )
      }
      {
        empresa.telefone && (
          <li class="flex items-center gap-[10px]">
            <svg width="16" height="16" viewBox="0 0 24 24" class="shrink-0" aria-hidden="true" set:html={icons.phone} />
            <a href={empresa.telefoneHref} class="hover:text-mint">
              {empresa.telefone}
            </a>
          </li>
        )
      }
      {
        empresa.site && (
          <li class="flex items-center gap-[10px]">
            <svg width="16" height="16" viewBox="0 0 24 24" class="shrink-0" aria-hidden="true" set:html={icons.globe} />
            <a href={empresa.site} target="_blank" rel="noopener" class="truncate hover:text-mint">
              {siteLabel}
            </a>
          </li>
        )
      }
    </ul>
  </div>

  <div class="border-t border-haze px-[20px] py-[14px]">
    <p class="text-[14px] leading-[22.4px] text-carbon">{empresa.categorias.join(" · ")}</p>
  </div>
</article>
