---
// Cada diferencial é um par: card branco (texto centralizado) + foto ao lado.
// Duas linhas de dois pares, como no original.
const items = [
  {
    titulo: "SALAS DE REUNIÃO E AUDITÓRIOS",
    desc: "Espaços com equipamentos multimídia e suporte técnico, disponíveis para locação por condôminos e público externo.",
    icone: "porta",
    foto: "/img/infra/salas.webp",
    anim: "slideInUp",
  },
  {
    titulo: "SEGURANÇA 24 HORAS",
    desc: "Sistema de monitoramento avançado e vagas amplas para visitantes e condôminos, garantindo tranquilidade.",
    icone: "relogio",
    foto: "/img/infra/seguranca.webp",
    anim: "slideInRight",
  },
  {
    titulo: "LOCALIZAÇÃO ESTRATÉGICA",
    desc: "Em frente ao Parque Villa Lobos, com vista privilegiada e fácil acesso pelas principais vias da cidade.",
    icone: "seta",
    foto: "/img/infra/localizacao.webp",
    anim: "fadeInLeft",
  },
  {
    titulo: "SERVIÇOS DE CONVENIÊNCIA",
    desc: "Lojas, doca de descarregamento, mensageria, estacionamento e muito mais!",
    icone: "relogio",
    foto: "/img/infra/conveniencia.webp",
    anim: "fadeInUp",
  },
];

const icones: Record<string, string> = {
  porta:
    '<path d="M3 21h18M6 21V4a1 1 0 0 1 1-1h7l5 3v15M13 12v1.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>',
  relogio:
    '<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8" fill="none"/><path d="M12 7v5.2l3.2 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/>',
  seta: '<path d="M21 3 3 10.5l7.5 3L13.5 21 21 3Z" fill="currentColor"/>',
};
---

<section class="px-6 py-16 lg:px-[61px]">
  <div class="mx-auto max-w-[1400px]">
    <div class="mx-auto mb-12 max-w-[900px] text-center">
      <span class="font-sans text-xl leading-5 font-semibold tracking-[2px] text-sand">
        DIFERENCIAIS E INFRAESTRUTURA
      </span>
      <h2 class="mt-5 font-sans text-[35px] leading-[35px] font-medium tracking-[1.5px] text-steel">
        UMA INFRAESTRUTURA CORPORATIVA COMPLETA PARA O SEU SUCESSO
      </h2>
      <p class="mt-6 font-sans text-xl leading-[30px] tracking-[0.5px] text-graytext">
        Conte com diferenciais que garantem a produtividade e o bem-estar de todos. Nossos
        espaços foram planejados para máxima flexibilidade e conforto para as empresas e
        seus clientes.
      </p>
    </div>

    <div class="grid gap-x-[30px] gap-y-[50px] lg:grid-cols-2">
      {
        items.map((item) => (
          <div
            class="grid grid-cols-1 sm:grid-cols-[343fr_312fr]"
            data-reveal={item.anim}
            data-reveal-delay="500"
          >
            <div class="flex min-h-[330px] flex-col items-center justify-center bg-white p-[30px] text-center">
              <span class="flex h-[60px] w-[60px] items-center justify-center rounded-[7px] bg-mint-claro text-white">
                <svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true" set:html={icones[item.icone]} />
              </span>
              <h3 class="mt-[15px] font-sans text-[26px] leading-[39px] font-semibold text-slate">
                {item.titulo}
              </h3>
              <p class="mt-[13px] font-sans text-xl leading-[26px] font-light text-graytext">
                {item.desc}
              </p>
            </div>

            <img
              src={item.foto}
              alt=""
              width="312"
              height="330"
              loading="lazy"
              class="h-[200px] w-full object-cover sm:h-full sm:min-h-[330px]"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
